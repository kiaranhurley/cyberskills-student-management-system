# Database Configuration
# PostgreSQL is the recommended database per Chapter 4 of the thesis
DATABASE_NAME=cyberskills_sms
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Set to 'true' ONLY if PostgreSQL is not available (not recommended)
# USE_SQLITE_FALLBACK=false

# Django Secret Key (generate a new one for production)
SECRET_KEY=django-insecure-change-this-in-production

# Password policy: relaxed by default for local/demo (min length 6; no similarity/common/numeric validators).
# For production set STRICT_PASSWORDS=true and PASSWORD_MIN_LENGTH=8 or higher.
# PASSWORD_MIN_LENGTH=6
# STRICT_PASSWORDS=false
